{"duration_api_ms":3082,"stop_reason":"end_turn","session_id":"7927a307-05b5-4588-b83a-fa80cd06a31c","total_cost_usd":0.0006918,"usage":{"input_tokens":2,"cache_creation_input_tokens":970,"cache_read_input_tokens":0,"output_tokens":672,"output_tokens_details":{"thinking_tokens":392},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":970,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":672,"cache_read_input_tokens":0,"cache_creation_input_tokens":970,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":970},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-haiku-5-5":{"inputTokens":1513,"outputTokens":693,"cacheReadInputTokens":0,"cacheCreationInputTokens":970,"webSearchRequests":0,"costUSD":0.0006918,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":392,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":970,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"An ETF's expense ratio isn't billed directly to investors. The fund accrues it daily as a percentage of net assets and deducts it before calculating net asset value (NAV). Investors pay indirectly, since share prices and returns are slightly lower than the underlying index or portfolio would produce.\n\nThe fund pays accrued amounts to the adviser and service providers, typically monthly or quarterly. The ratio covers the management fee plus operating costs such as administration, custody, transfer agency, audit, and legal. Advisers sometimes waive or reimburse part of expenses, which lowers the effective ratio.\n\nInvestors receive no separate fee statement. The cost appears in the fund's prospectus, annual report, and reported performance, which is shown net of fees. Brokerage commissions, if any, are charged separately by the broker and are not part of the expense ratio.","ttft_ms":1690,"type":"result","duration_ms":2505,"uuid":"63ff981b-3a68-4e8f-b1a2-40e880e3e8a6","ttft_stream_ms":408,"time_to_request_ms":55,"first_content_frame_ms":408,"queued_turn_count":0,"result_index":0,"credential_expires_at":"2026-11-28T06:36:39.484Z"}
