{"duration_api_ms":6217,"stop_reason":"end_turn","session_id":"ac68a59d-8f7f-40c7-bced-8ed17804e742","total_cost_usd":0.0011969,"usage":{"input_tokens":2,"cache_creation_input_tokens":1004,"cache_read_input_tokens":0,"output_tokens":1663,"output_tokens_details":{"thinking_tokens":1347},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1004,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1663,"cache_read_input_tokens":0,"cache_creation_input_tokens":1004,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1004},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-haiku-5-5":{"inputTokens":1546,"outputTokens":1683,"cacheReadInputTokens":0,"cacheCreationInputTokens":1004,"webSearchRequests":0,"costUSD":0.0011969,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":1347,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":1004,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"**Authorized Participants (APs)** are large institutions, typically broker-dealers, with signed agreements with an ETF's distributor. Only APs can create or redeem shares directly with the fund, in large blocks called creation units (often 25,000 to 100,000 shares). They exchange baskets of underlying securities, or cash, for ETF shares, keeping the ETF's market price close to its net asset value (NAV).\n\n**Market makers** provide continuous two-sided quotes on the exchange, earning the bid-ask spread and giving investors liquidity. They don't need an AP agreement, though many are also APs and use creations and redemptions to offset inventory and hedge risk.\n\n**Key difference:** APs have a direct primary-market relationship with the fund, while market makers operate in the secondary market. Most ETF trades occur between investors and market makers on exchange, and APs arbitrage any gap between ETF price and NAV, keeping the ETF trading near fair value.","ttft_ms":4756,"type":"result","duration_ms":5632,"uuid":"427bc09e-6b65-44a9-a690-47c871280157","ttft_stream_ms":434,"time_to_request_ms":67,"first_content_frame_ms":434,"queued_turn_count":0,"result_index":0,"credential_expires_at":"2026-11-28T06:36:39.484Z"}
