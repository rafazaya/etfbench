{"duration_api_ms":9989,"stop_reason":"end_turn","session_id":"8aeeedeb-1cdb-435e-a4ae-5f3fc10da499","total_cost_usd":0.023494700000000004,"usage":{"input_tokens":2,"cache_creation_input_tokens":654,"cache_read_input_tokens":0,"output_tokens":906,"output_tokens_details":{"thinking_tokens":492},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":654,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":906,"cache_read_input_tokens":0,"cache_creation_input_tokens":654,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":654},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-haiku-5-5":{"inputTokens":1222,"outputTokens":25,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.00013470000000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"},"claude-opus-5-5":{"inputTokens":2,"outputTokens":906,"cacheReadInputTokens":0,"cacheCreationInputTokens":654,"webSearchRequests":0,"costUSD":0.023360000000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":492,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":654,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"**ICAV vs. Irish investment plc**\n\n| Feature | ICAV (ICAV Act 2015) | Investment plc (Companies Act 2014, Part 24) |\n|---|---|---|\n| **Per-sub-fund accounts** | An umbrella ICAV may prepare separate financial statements for each sub-fund. | Accounts must be prepared for the umbrella company as a whole. Sub-fund figures appear within them, but standalone statements aren't permitted. |\n| **AGMs** | The board can dispense with AGMs by giving shareholders notice. Shareholders, or the auditor, can still require one. | AGMs are generally mandatory. Dispensing with one requires unanimous written shareholder consent, which is impractical for a listed ETF. |\n| **US tax classification** | Not a \"per se corporation\" under US Treasury regulations, so it can make a check-the-box election to be treated as a partnership or disregarded entity. In practice this is often done sub-fund by sub-fund, which avoids PFIC treatment for US investors. | An Irish plc is on the per se corporation list, so it is always treated as a corporation and cannot elect. |\n\nThis flexibility is why most new Irish ETF umbrellas use the ICAV form.","ttft_ms":5843,"type":"result","duration_ms":9504,"uuid":"2548a39d-1b66-4372-8904-c6d6ff277323","ttft_stream_ms":483,"time_to_request_ms":67,"first_content_frame_ms":483,"queued_turn_count":0,"result_index":0,"credential_expires_at":"2026-11-28T06:36:39.484Z"}
