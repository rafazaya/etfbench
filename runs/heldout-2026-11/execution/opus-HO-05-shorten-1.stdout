{"duration_api_ms":7476,"stop_reason":"end_turn","session_id":"4e73b776-b2a6-43e5-8fe7-6ffd727d9161","total_cost_usd":0.0249978,"usage":{"input_tokens":2,"cache_creation_input_tokens":1057,"cache_read_input_tokens":0,"output_tokens":818,"output_tokens_details":{"thinking_tokens":472},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1057,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":818,"cache_read_input_tokens":0,"cache_creation_input_tokens":1057,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1057},"type":"message"}],"speed":"standard","fallback_credit":null},"modelUsage":{"claude-haiku-5-5":{"inputTokens":1623,"outputTokens":23,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":0.00017380000000000002,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":0,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":0,"canonicalModel":"claude-haiku-5-5","provider":"firstParty","costBasis":"list"},"claude-opus-5-5":{"inputTokens":2,"outputTokens":818,"cacheReadInputTokens":0,"cacheCreationInputTokens":1057,"webSearchRequests":0,"costUSD":0.024824,"contextWindow":1000000,"maxOutputTokens":128000,"thinkingTokens":472,"cacheCreationEphemeral5mInputTokens":0,"cacheCreationEphemeral1hInputTokens":1057,"canonicalModel":"claude-opus-5-5","provider":"firstParty","costBasis":"list"}},"permission_denials":[],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":1,"subtype":"success","api_error_status":null,"result":"**ICAV vs. Irish investment plc**\n\n| Feature | ICAV (ICAV Act 2015) | Investment plc (Companies Act 2014, Part 24) |\n|---|---|---|\n| **Sub-fund accounts** | An umbrella may prepare separate financial statements for each sub-fund. | Umbrella-level accounts only. Sub-fund figures are included, but standalone statements aren't permitted. |\n| **AGMs** | The board may dispense with AGMs by notice. Shareholders or the auditor can still require one. | Generally mandatory. Dispensing requires unanimous written shareholder consent, which is impractical for listed ETFs. |\n| **US tax** | Not a \"per se corporation,\" so it can check-the-box to be a partnership or disregarded entity. This is often done per sub-fund, avoiding PFIC treatment for US investors. | On the per se corporation list, so it is always a corporation and cannot elect. |\n\nThis flexibility is why most new Irish ETF umbrellas are ICAVs.","ttft_ms":4594,"type":"result","duration_ms":6956,"uuid":"c4d88c9c-b710-4009-962a-90d3d68db480","ttft_stream_ms":522,"time_to_request_ms":76,"first_content_frame_ms":522,"queued_turn_count":0,"result_index":0,"credential_expires_at":"2026-11-28T06:36:39.484Z"}
